{
  "name": "xeno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx @cloudflare/next-on-pages@1",
    "deploy:cloud": "npm run build && npx wrangler pages deploy .vercel/output/static --project-name xeno",
    "pages:build": "npx @cloudflare/next-on-pages@1",
    "build:next": "next build",
    "preview": "wrangler pages dev .vercel/output/static",
    "start": "next start",
    "test": "npx tsx scripts/test-helpers.ts && npx tsx scripts/test_confirm_modal.ts",
    "check:db": "npx tsx scripts/check-connection.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@11.12.0"
}
